{
  "name": "@chat-automation/api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "cache": true,
        "executor": "@nx/js:tsc",
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "outputPath": "apps/api/dist",
          "main": "apps/api/src/main.ts",
          "tsConfig": "apps/api/tsconfig.app.json",
          "rootDir": "apps/api/src",
          "generatePackageJson": false
        },
        "configurations": {
          "development": {},
          "production": {}
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/api/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/api/dist/patches",
          "{workspaceRoot}/apps/api/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@chat-automation/api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@chat-automation/api:build:development"
          },
          "production": {
            "buildTarget": "@chat-automation/api:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "migration-generate": {
        "cache": false,
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
          "cwd": "apps/api",
          "env": {
            "TS_NODE_PROJECT": "tsconfig.app.json"
          }
        }
      },
      "migration-create": {
        "cache": false,
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec typeorm-ts-node-commonjs migration:create",
          "cwd": "apps/api",
          "env": {
            "TS_NODE_PROJECT": "tsconfig.app.json"
          }
        }
      },
      "migration-run": {
        "cache": false,
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
          "cwd": "apps/api",
          "env": {
            "TS_NODE_PROJECT": "tsconfig.app.json"
          }
        }
      },
      "migration-revert": {
        "cache": false,
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
          "cwd": "apps/api",
          "env": {
            "TS_NODE_PROJECT": "tsconfig.app.json"
          }
        }
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.3",
    "@types/uuid": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.3.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.31",
    "typeorm-dynamic-filters": "^0.1.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0"
  }
}
